FROM wechatopenai/weknora-ui:v0.8.2
COPY dist/ /usr/share/nginx/html/
COPY structured-proxy.conf /etc/nginx/structured-proxy.conf
COPY research-proxy.conf /etc/nginx/research-proxy.conf
RUN sed -i '/server_name localhost;/a\    include /etc/nginx/structured-proxy.conf;\n    include /etc/nginx/research-proxy.conf;' /etc/nginx/templates/default.conf.template
