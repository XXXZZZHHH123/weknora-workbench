# Server-only configuration. bootstrap.sh generates the blank secrets once.
DB_USER=weknora
DB_NAME=WeKnora
DB_PASSWORD=
REDIS_PASSWORD=
JWT_SECRET=
SYSTEM_AES_KEY=
SYSTEM_SIGNING_KEY=
TZ=Asia/Shanghai
LOG_LEVEL=info
AUTO_MIGRATE=true
OLLAMA_OPTIONAL=true
# Enable registration for the first account, then change this to true.
DISABLE_REGISTRATION=false
WEKNORA_AUTH_COMPLEX_PASSWORD_ENABLED=true
# Set to 0.0.0.0 to serve the internal network, or keep loopback for a host proxy.
FRONTEND_BIND=127.0.0.1
FRONTEND_PORT=18080
# Exact browser origin when serving an IP/domain beyond localhost.
STRUCTURED_PUBLIC_ORIGIN=
# Confirm the tenant ID after registering the first account.
STRUCTURED_TENANT_ID=10000

# Optional isolated PDF layout worker. Empty = explicit unavailable UI, no text-only fallback.
# mineru_v1 (MinerU 4 HTTP API), mineru_legacy (/file_parse), or paddleocr_vl.
PDF_TABLE_PARSER_ENGINE=
PDF_TABLE_PARSER_URL=
PDF_TABLE_PARSER_API_KEY=
PDF_TABLE_PARSER_TIER=basic
