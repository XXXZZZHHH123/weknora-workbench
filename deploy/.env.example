# Server-only configuration. bootstrap.sh generates the blank secrets once.
DB_USER=weknora
DB_NAME=WeKnora
DB_PASSWORD=
REDIS_PASSWORD=
JWT_SECRET=
SYSTEM_AES_KEY=
SYSTEM_SIGNING_KEY=
TZ=Asia/Shanghai
LOG_LEVEL=info
AUTO_MIGRATE=true
OLLAMA_OPTIONAL=true
# Enable registration for the first account, then change this to true.
DISABLE_REGISTRATION=false
WEKNORA_AUTH_COMPLEX_PASSWORD_ENABLED=true
# Set to 0.0.0.0 to serve the internal network, or keep loopback for a host proxy.
FRONTEND_BIND=127.0.0.1
FRONTEND_PORT=18080
# Confirm the tenant ID after registering the first account.
STRUCTURED_TENANT_ID=10000
